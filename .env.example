# Copie para .env na VM (o arquivo .env fica fora do git) e preencha os valores reais.
# O docker compose lê automaticamente o .env que estiver ao lado do docker-compose.yml.

# Login do painel Admin
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Texto longo e aleatório usado para assinar o cookie de sessão
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Acesso somente leitura ao Zabbix
ZABBIX_URL=https://zabbix.ivitelecom.com.br
ZABBIX_USER=monitoramento
ZABBIX_PASSWORD=coloque-a-senha-aqui

# Visualizadores do mapa, no formato usuario:senha,usuario2:senha2 (deixe vazio se não houver)
MAP_USERS=
